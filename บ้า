--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local SpeedValue = 16
local HighJump = false

local function GetHumanoid()
	local Character = Player.Character
	if not Character then
		return nil
	end

	return Character:FindFirstChildOfClass("Humanoid")
end

local function ApplySettings()
	local Humanoid = GetHumanoid()

	if not Humanoid then
		return
	end

	Humanoid.WalkSpeed = SpeedValue

	if HighJump then
		Humanoid.UseJumpPower = true
		Humanoid.JumpPower = 100
	else
		Humanoid.UseJumpPower = true
		Humanoid.JumpPower = 50
	end
end

--------------------------------------------------
-- SPEED
--------------------------------------------------

SpeedButton.MouseButton1Click:Connect(function()

	local Number = tonumber(SpeedBox.Text)

	if not Number then
		Status.Text = "กรุณาใส่ตัวเลข"
		Status.TextColor3 = Color3.fromRGB(255, 130, 130)
		return
	end

	Number = math.clamp(Number, 1, 1000)

	SpeedValue = Number
	SpeedBox.Text = tostring(Number)
	SpeedLabel.Text = "ความเร็ว: " .. Number

	ApplySettings()

	Status.Text = "ตั้งความเร็วเป็น " .. Number
	Status.TextColor3 = Color3.fromRGB(150, 220, 170)
end)

